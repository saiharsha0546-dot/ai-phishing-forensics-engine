{
  "manifest_version": 3,
  "name": "SOC Forensics Real-time Telemetry",
  "version": "1.0",
  "description": "Streams live browser navigation events directly to your SOC Forensics Engine backend.",
  "permissions": [
    "webNavigation",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOC Telemetry Config"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ]
}
